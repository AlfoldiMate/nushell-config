{
  description: "The terminal itself: which one you have (`terminal`), its theme (`theme`), its configuration (`ghostty`)"
  docs: "README.md"
  # paid on the first `theme`, `ghostty` or `font`, not at startup. 72.1 ms of
  # startup with it eager against 58.8 ms lazy, medians of 25, 2026-09-19.
  cost: 13ms
  # For commands a shell uses once in a while, so lazy: on `theme`, `ghostty` or
  # `font` (MODULES_TRIGGERS) — the words its commands start with.
  lazy: true
  requires: [
    {
      bin: "ghostty"
      hard: true
      why: "the themes, their files and the config being written are all Ghostty's"
      # Ghostty on macOS is an app bundle: the binary is on PATH only inside a
      # Ghostty window, where its shell integration prepends GHOSTTY_BIN_DIR.
      paths: ["/Applications/Ghostty.app/Contents/MacOS/ghostty" "~/Applications/Ghostty.app/Contents/MacOS/ghostty"]
      install: {
        macos: "brew install --cask ghostty"
        linux: "your package manager, or https://ghostty.org/download"
        windows: "no Windows build yet — https://ghostty.org/download"
      }
    }
  ]
  knobs: {}
}
