# catppuccin-frappe.nuon — Catppuccin Frappe, all 26 of its colours, for the
# Ghostty theme of the same name (`theme use "Catppuccin Frappe"`).
#
# A palette file is tier three of theme resolution: it names the shaded roles
# exactly instead of blending them from the theme's background and foreground.
# This one has no `terminal` block of its own: `ghostty` names the theme whose
# file supplies the sixteen, and the sixteen stay the terminal's — a role like
# `red` is never overridden here — so what this adds is the greys, the surfaces
# and the hues ANSI lacks.
# README.md has the role list; `colours` may hold any names, and a role may be
# one of them or a colour of its own.
#
# The values are Catppuccin's published palette, the same ones bat's and vivid's
# Catppuccin themes use, which is why those two are named here rather than
# rendered from the roles.
{
  name: "Catppuccin Frappe"
  ghostty: "Catppuccin Frappe"     # the Ghostty theme this palette extends: its sixteen are the terminal's
  bat: "Catppuccin Frappe"
  vivid: "catppuccin-frappe"
  dark: true
  colours: {
    rosewater: "#f2d5cf"
    flamingo: "#eebebe"
    pink: "#f4b8e4"
    mauve: "#ca9ee6"
    red: "#e78284"
    maroon: "#ea999c"
    peach: "#ef9f76"
    yellow: "#e5c890"
    green: "#a6d189"
    teal: "#81c8be"
    sky: "#99d1db"
    sapphire: "#85c1dc"
    blue: "#8caaee"
    lavender: "#babbf1"
    text: "#c6d0f5"
    subtext1: "#b5bfe2"
    subtext0: "#a5adce"
    overlay2: "#949cbb"
    overlay1: "#838ba7"
    overlay0: "#737994"
    surface2: "#626880"
    surface1: "#51576d"
    surface0: "#414559"
    base: "#303446"
    mantle: "#292c3c"
    crust: "#232634"
  }
  roles: {
    fg: text
    fg_dim: subtext0
    fg_muted: overlay1
    bg: base
    bg_alt: mantle
    bg_surface: surface0
    border: surface1
    orange: peach
    purple: mauve
    pink: pink
    teal: teal
    accent: blue
    accent_alt: lavender
    ok: green
    warn: yellow
    err: red
    info: sapphire
    hint: overlay0
    on_accent: crust
  }
}
