# catppuccin-macchiato.nuon — Catppuccin Macchiato, all 26 of its colours, for the
# Ghostty theme of the same name (`theme use "Catppuccin Macchiato"`).
#
# A palette file is tier three of theme resolution: it names the shaded roles
# exactly instead of blending them from the theme's background and foreground.
# This one has no `terminal` block of its own: `ghostty` names the theme whose
# file supplies the sixteen, and the sixteen stay the terminal's — a role like
# `red` is never overridden here — so what this adds is the greys, the surfaces
# and the hues ANSI lacks.
# README.md has the role list; `colours` may hold any names, and a role may be
# one of them or a colour of its own.
#
# The values are Catppuccin's published palette, the same ones bat's and vivid's
# Catppuccin themes use, which is why those two are named here rather than
# rendered from the roles.
{
  name: "Catppuccin Macchiato"
  ghostty: "Catppuccin Macchiato"     # the Ghostty theme this palette extends: its sixteen are the terminal's
  bat: "Catppuccin Macchiato"
  vivid: "catppuccin-macchiato"
  dark: true
  colours: {
    rosewater: "#f4dbd6"
    flamingo: "#f0c6c6"
    pink: "#f5bde6"
    mauve: "#c6a0f6"
    red: "#ed8796"
    maroon: "#ee99a0"
    peach: "#f5a97f"
    yellow: "#eed49f"
    green: "#a6da95"
    teal: "#8bd5ca"
    sky: "#91d7e3"
    sapphire: "#7dc4e4"
    blue: "#8aadf4"
    lavender: "#b7bdf8"
    text: "#cad3f5"
    subtext1: "#b8c0e0"
    subtext0: "#a5adcb"
    overlay2: "#939ab7"
    overlay1: "#8087a2"
    overlay0: "#6e738d"
    surface2: "#5b6078"
    surface1: "#494d64"
    surface0: "#363a4f"
    base: "#24273a"
    mantle: "#1e2030"
    crust: "#181926"
  }
  roles: {
    fg: text
    fg_dim: subtext0
    fg_muted: overlay1
    bg: base
    bg_alt: mantle
    bg_surface: surface0
    border: surface1
    orange: peach
    purple: mauve
    pink: pink
    teal: teal
    accent: blue
    accent_alt: lavender
    ok: green
    warn: yellow
    err: red
    info: sapphire
    hint: overlay0
    on_accent: crust
  }
}
